<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checks every minute for a scan request from the hosted dashboard, and scans
  anyway if the data has gone stale (default two hours).

  Every minute sounds like a lot for a job that scans every two hours, but the
  check exits in well under a second when there is nothing to do -- and it is
  what makes the button on the hosted dashboard feel like a button rather than
  a form submission that might be answered later.

  Install:
    cp scripts/com.supreme-jp-monitor.scan.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.supreme-jp-monitor.scan.plist

  Check:   launchctl list | grep supreme
  Log:     tail -f ~/Library/Logs/supreme-jp-monitor/scan.log
  Stop:    launchctl unload ~/Library/LaunchAgents/com.supreme-jp-monitor.scan.plist

  Replace dannguyentien below if the account differs -- launchd expands neither
  ~ nor $HOME inside a ProgramArguments path.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.supreme-jp-monitor.scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/dannguyentien/Downloads/supreme-jp-monitor/scripts/scheduled-scan.sh</string>
  </array>

  <!-- Only while the Mac is awake: launchd will not wake a sleeping machine for
       this, it runs the job once the machine is up again. -->
  <key>StartInterval</key>
  <integer>60</integer>

  <!-- At load: the first check is cheap and proves the job works, rather than
       leaving the owner to wonder for a minute whether it installed. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/dannguyentien/Library/Logs/supreme-jp-monitor/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dannguyentien/Library/Logs/supreme-jp-monitor/launchd.err.log</string>
</dict>
</plist>
