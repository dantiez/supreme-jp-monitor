# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Neon Postgres. This tool cannot run without it: its entire value is comparing
# today's stock against yesterday's, and there is nowhere else to keep that.
#
# All tables live in the `supreme_monitor` SCHEMA, not `public`. That is
# deliberate — the instance may be shared with the StockX exporter, which owns a
# `products` table with different columns. Without the namespace,
# `CREATE TABLE IF NOT EXISTS products` would find that table, skip creation,
# and leave every insert writing against the wrong shape.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Notifications (optional, but the point of a monitor)
# ---------------------------------------------------------------------------
# Discord webhook. Server Settings -> Integrations -> Webhooks -> New Webhook.
# Without it the scan still records every change; it just tells nobody.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# ---------------------------------------------------------------------------
# Crawl politeness
# ---------------------------------------------------------------------------
# Gap between requests, milliseconds. Requests are serialised, so this is the
# effective rate. A few hundred products every couple of hours is real load on
# someone else's shop — do not lower this without a reason.
# REQUEST_DELAY_MS="800"

# How the client identifies itself. Honest by default rather than impersonating
# a browser; Supreme serves these pages to ordinary clients and robots.txt
# allows /collections/ and /products/.
# SCRAPER_USER_AGENT="supreme-jp-monitor/0.1 (stock monitor; contact: you@example.com)"

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# HOST="127.0.0.1"
# PORT="3100"
